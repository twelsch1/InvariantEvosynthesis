parent.0 = lexicaseparent.params

# We have one function set, of class GPFunctionSet
gp.fs.size = 1
gp.fs.0 = ec.gp.GPFunctionSet
# We'll call the function set "f0".
gp.fs.0.name = f0


#was 1024
pop.subpop.0.size = 1000

#Remember to reset to 25
generations = 25
evalthreads = 1
verificationthreads = 1
breedthreads = 1
silent=true
checkICE=true


#select.tournament.size = 7

#jobs = 10

eval.problem = evosynthesis.CLIAProblem
eval.problem.data = datatypes.LongData

# output statistics to the file "out.stat" in the directory
# the run was started in
stat.file				$out.stat